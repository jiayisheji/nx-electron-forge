{
  "name": "@nx-electron-forge/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "lint": "nx run-many -t lint",
    "spellcheck": "cspell lint --no-progress --no-must-find-files \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "check": "pnpm format:check && pnpm lint && pnpm spellcheck"
  },
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nx/eslint": "^22.7.2",
    "@nx/eslint-plugin": "^22.7.2",
    "@nx/js": "22.7.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "commitizen": "^4.3.0",
    "cspell": "^8.8.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "~9.8.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "nx": "22.7.2",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
